# Copy to .env, chmod 600 .env, and replace placeholders before use.
# Signing key from Android Settings -> Webhooks -> Signing Key (text, not hex-decoded).
SMS_GATEWAY_SIGNING_KEY=REPLACE_WITH_ANDROID_SIGNING_KEY
# Omit this line entirely for transform-only use. Empty URL is rejected.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_NUMERIC_ID/REPLACE_WITH_TOKEN
BIND_ADDR=0.0.0.0:8080
